// ==========================================
// 1. BASIC WHILE LOOP
// ==========================================

int whileCounter = 0;

while (whileCounter < 5)
{
    whileCounter++;
}


// ==========================================
// 2. WHILE LOOP WITH A COMPOUND CONDITION
// ==========================================

int a = 0;

while (a < 10 && a != 7)
{
    a++;
}


// ==========================================
// 3. WHILE LOOP WITH A SINGLE STATEMENT BODY
// ==========================================

int singleBody = 0;

while (singleBody < 3)
    singleBody++;


// ==========================================
// 4. NESTED WHILE LOOPS
// ==========================================

int outer = 0;
int innerTotal = 0;

while (outer < 3)
{
    int inner = 0;

    while (inner < 2)
    {
        innerTotal = innerTotal + 1;
        inner++;
    }

    outer++;
}


// ==========================================
// 5. BASIC FOR LOOP
// ==========================================

int forTotal = 0;

for (int i = 0; i < 10; i++)
{
    forTotal = forTotal + i;
}


// ==========================================
// 6. FOR LOOP WITH DECREMENT
// ==========================================

int countdown = 5;

for (; countdown > 0; countdown--)
{
    forTotal = forTotal + countdown;
}


// ==========================================
// 7. FOR LOOP WITH AN ASSIGNMENT INITIALIZER
// ==========================================

int j = 0;

for (j = 0; j < 5; j++)
{
    forTotal = forTotal + j;
}


// ==========================================
// 8. FOR LOOP WITH AN EMPTY INITIALIZER
// ==========================================

int k = 0;

for (; k < 4; k++)
{
    forTotal = forTotal + k;
}


// ==========================================
// 9. FOR LOOP WITH AN EMPTY ITERATOR
// ==========================================

int m = 0;

for (int n = 0; n < 3;)
{
    m++;
    n++;
}


// ==========================================
// 10. FOR LOOP WITH AN EMPTY CONDITION
// Do not execute until you support break.
// ==========================================

// for (int p = 0;; p++)
// {
//     doSomething();
// }


// ==========================================
// 11. NESTED FOR LOOPS
// ==========================================

int nestedTotal = 0;

for (int row = 0; row < 3; row++)
{
    for (int column = 0; column < 4; column++)
    {
        nestedTotal = nestedTotal + 1;
    }
}


// ==========================================
// 12. FOR LOOP CONTAINING A WHILE LOOP
// ==========================================

int mixedTotal = 0;

for (int q = 0; q < 3; q++)
{
    int r = 0;

    while (r < 2)
    {
        mixedTotal = mixedTotal + 1;
        r++;
    }
}


// ==========================================
// 13. WHILE LOOP CONTAINING A FOR LOOP
// ==========================================

int outerWhile = 0;
int mixedNestedTotal = 0;

while (outerWhile < 2)
{
    for (int s = 0; s < 3; s++)
    {
        mixedNestedTotal = mixedNestedTotal + 1;
    }

    outerWhile++;
}


// ==========================================
// 14. FUNCTION CALL IN A LOOP CONDITION
// ==========================================

int limit()
{
    return 3;
}

int callCounter = 0;

while (callCounter < limit())
{
    callCounter++;
}


// ==========================================
// 15. RECURSIVE FUNCTION CALL INSIDE A LOOP
// ==========================================

int calculate(int value)
{
    if (value <= 1)
    {
        return 1;
    }
    else
    {
        return value * calculate(value - 1);
    }
}

int factorialResult = 0;

for (int f = 1; f <= 5; f++)
{
    factorialResult = calculate(f);
}


// ==========================================
// 16. LOOP WITH A CONDITIONAL
// ==========================================

int conditionCounter = 0;
int evenTotal = 0;

while (conditionCounter < 10)
{
    if (conditionCounter % 2 == 0)
    {
        evenTotal = evenTotal + conditionCounter;
    }

    conditionCounter++;
}


// ==========================================
// 17. MULTIPLE NESTED BLOCKS
// ==========================================

int blockCounter = 0;

for (int u = 0; u < 3; u++)
{
    {
        {
            blockCounter++;
        }
    }
}


// ==========================================
// 18. EMPTY LOOP BODY
// ==========================================

// Valid only if your grammar permits an empty statement.
// Otherwise, leave this disabled.

// while (false) ;
// for (int v = 0; v < 0; v++) ;


// ==========================================
// 19. LOOP WITH A COMPLEX CONDITION
// ==========================================

int complexCounter = 0;

for (int w = 0; w < 20 && w != 8; w++)
{
    complexCounter++;
}


// ==========================================
// 20. LOOP WITH A FUNCTION CALL AS A STATEMENT
// ==========================================

int logValue(int value)
{
    return value;
}

for (int z = 0; z < 3; z++)
{
    logValue(z);
}
