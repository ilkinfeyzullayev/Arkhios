bool logical(int x, int y, int z)
{
    var a = x > 10 && y < 20;
    var b = x > 10 || y < 20;
    var c = x > 10 && y < 20 || z == 5;
    var d = !(x == y);
    var e = !!true;
    var f = !(x > 5 && y < 10);
}


// ===== Function calls =====

float calls(float x)
{
    var a = sqrt(x);
    var b = foo(x, 10);
    var c = calculate(x + 5, -(x ^ 2));
    var d = outer(inner(x), second(x, 2));
    var e = foo();
    var f = foo(bar(x), baz(1, 2, 3));
}


// ===== Everything together =====

complex monster(
    int a,
    float b,
    complex c,
    int d,
    float e
)
{
    var x = a + b * 2;
    var y = (a + b) * (d - 3);
    var z = -(x ^ 2);

    var comparison =
        x >= 100 &&
        y < 500 ||
        d == 42;

    var call1 = sqrt(x);
    var call2 = calculate(
        x + y,
        -(z ^ 2)
    );

    var call3 = outer(
        inner(a, b),
        second(
            x,
            y,
            foo(c)
        )
    );

    {
        var nested1 = x + y;
        {
            var nested2 = nested1 * 2;
            {
                var nested3 = -(nested2 ^ 3);

                {
                    var nested4 =
                        foo(
                            nested3,
                            bar(nested2),
                            baz(x, y, z)
                        );
                }
            }
        }
    }

    {
        int shadow = 10;

        {
            int shadow = 20;

            {
                int shadow = 30;
            }
        }
    }
}


// ===== More declarations after complex functions =====

void afterMonster()
{
    int x = 123;

    {
        float y = 57.25;

        {
            complex z = foo(
                x,
                y,
                -(x ^ 2)
            );
        }
    }
}

int finalFunction(int x, int y)
{
    var result =
        foo(
            x + y,
            bar(
                x * y
            ),
            baz(
                x ^ 2,
                y ^ 2
            )
        );
}